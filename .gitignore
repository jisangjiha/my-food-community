# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static

# 로컬 도구 설정 — 개인 환경이라 공유하지 않는다.
# .mcp.json은 비밀값은 없지만 Supabase 프로젝트 ref가 들어 있다.
.claude/settings.local.json
.mcp.json

# 작업용 로컬 자산 — 앱이 쓰지 않는다. (public/ 아래 것만 실제로 쓰인다)
/images/
/reference*.png
/PretendardVariable.woff2
