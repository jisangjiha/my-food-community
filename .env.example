# Supabase — 서버 전용. CLAUDE.md 규칙상 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# 브라우저 번들에 들어가면 안 되므로, 이 값들은 BFF(서버) 코드에서만 읽는다.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 공개 Storage 객체 주소의 앞부분. 버킷 이름 바로 앞까지 적는다.
# DB에는 경로만 저장하고, 이 값을 붙여 최종 URL을 만든다. CDN/커스텀 도메인으로
# 갈아끼울 때 이 한 줄만 바꾸면 된다.
SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co/storage/v1/object/public

# 외부 이미지 호스트의 주소 앞부분. 버킷 대신 여기서 오는 이미지에 붙는다.
# 상품 상세 이미지는 아직 우리 버킷에 없어 Unsplash를 쓴다. Storage와 같은 규칙이다 —
# 앞단(호스트)은 이 값, 뒷단(경로+쿼리)은 product 테이블의 image_path_detail_* 컬럼.
# 이미지를 버킷으로 옮기면 이 줄을 지우고 DB 컬럼을 파일명으로 바꾸면 된다.
UNSPLASH_IMAGE_URL=https://images.unsplash.com

# 서비스 롤 키. RLS를 통째로 우회하므로 진짜 비밀값이다. 절대 클라이언트로
# 내려보내지 않는다.
#
# 쓰는 곳은 결제 웹훅 하나다. 웹훅은 포트원 서버가 부르는 것이라 쿠키도 세션도
# 없고, 그래서 auth.uid()가 없다. 사용자를 대신해 결제 원장에 행을 남기려면
# RLS 바깥에서 security definer 함수를 부르는 수밖에 없다.
# src/lib/supabase/server.ts의 createServiceClient()만 이 값을 읽는다.
#
# 없으면 웹훅이 500으로 답하고, 포트원이 재전송한다 — 값을 채우면 밀린 웹훅이
# 다시 들어온다. 나머지 화면과 리다이렉트 결제 확정은 이 값 없이도 정상이다.
SUPABASE_SECRET_KEY=sb_secret_xxx

# 네이버 지도 JS API. NCP 콘솔 > Maps > Application에서 발급한 Client ID(Key ID).
# 브라우저에 노출되는 값이라 비밀값이 아니다. 실제 방어선은 NCP 콘솔에 등록한
# "Web 서비스 URL" 허용목록이므로, 배포 도메인과 개발용 주소를 모두 등록한다.
# NEXT_PUBLIC_을 붙이지 않는 이유: 노출 경로를 서버 컴포넌트 한 곳으로 좁히기
# 위해서다. src/lib/maps/env.ts만 이 값을 읽는다.
# 비워 두면 지도 대신 기존 도식이 보인다 — 앱은 정상 동작한다.
NAVER_MAP_CLIENT_ID=

# 네이버 지역검색 API. NCP 콘솔 > API Hub > Search 이용 신청 후 발급한다.
# 위의 지도 키와 별개다.
# 이 둘은 진짜 비밀값이다. 서버에서만 읽고 브라우저로 내보내지 않는다.
# 없으면 장소 검색 화면이 500이 된다 — 검색이 그 화면의 존재 이유라 폴백이 없다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 네이버 리버스 지오코딩 API. NCP 콘솔 > Maps 이용 신청 후 발급한다.
# 지역검색 키(NAVER_SEARCH_*)와도, 브라우저 지도 키(NAVER_MAP_CLIENT_ID)와도 다르다.
# 호스트부터 다르다 — 이쪽은 maps.apigw.ntruss.com이다.
# 요청 헤더 x-ncp-apigw-api-key-id / x-ncp-apigw-api-key에 그대로 실린다.
# 진짜 비밀값이다. 서버에서만 읽고 브라우저로 내보내지 않는다.
# 없으면 지도를 움직여도 주소 자리가 "주소를 불러오지 못했어요"에 머문다.
NAVER_GEOCODE_API_KEY_ID=
NAVER_GEOCODE_API_KEY=

# 포트원(PortOne) V2. 콘솔 > 결제연동 탭에서 확인·발급한다.
# 세 값의 성격이 다르므로 다루는 법도 다르다.
#
# Store ID와 채널 키는 결제창을 여는 데 쓰여 어차피 브라우저에 보인다. 비밀값이
# 아니다. 그런데도 NEXT_PUBLIC_을 붙이지 않는 이유는 NAVER_MAP_CLIENT_ID와 같다 —
# 접두사를 빼 두면 Next.js가 아무 클라이언트 번들에나 값을 인라인하지 않아서,
# 값이 나가는 지점이 상품 상세 한 곳으로 좁혀진다. src/lib/payments/env.ts만
# 이 값들을 읽는다.
# 비워 두면 상품 상세는 그대로 보이고 결제 버튼만 잠긴다 — 앱은 정상 동작한다.
PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# V2 API 시크릿. 이쪽은 진짜 비밀값이다. 이 값이 있으면 아무 결제 건이나 조회하고
# 취소할 수 있다. 서버에서만 읽고 브라우저로 내보내지 않는다.
# 없으면 결제 완료 검증이 그 자리에서 터진다 — 검증 없이 결제를 기록하느니 500이
# 낫기 때문에 폴백을 두지 않았다.
PORTONE_API_SECRET=

# V2 웹훅 시크릿. 콘솔 > 결제연동 > 연동 관리 > 결제알림(Webhook) 관리 탭에서
# [웹훅 시크릿 발급]으로 받는다. 위의 API 시크릿과 다른 값이다.
#
# 이 값으로 결제를 조회하거나 취소할 수는 없지만, 그래도 비밀값이다 — 새어 나가면
# 아무나 "결제가 완료되었다"는 웹훅을 위조해 보낼 수 있다.
# 무중단 교체를 위해 테스트/실연동 환경별로 최대 2개까지 발급할 수 있다.
#
# 같은 탭에서 Endpoint URL도 함께 등록한다: https://<배포주소>/api/payments/webhook
# (Content Type은 application/json, 웹훅 버전은 2024-04-25)
#
# 없으면 웹훅이 500으로 답한다. 검증 없이 웹훅을 처리하느니 500이 낫고, 500이면
# 포트원이 재전송하므로 값을 채운 뒤 밀린 웹훅이 다시 들어온다.
PORTONE_WEBHOOK_SECRET=
